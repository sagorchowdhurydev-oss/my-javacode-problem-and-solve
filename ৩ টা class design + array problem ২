import java.util.Arrays;
public class student_4 {
    public String name;
    public int id;
    public Course [] CourseDtls = new Course[5];
    public int coursecount;
    public int [] arr1 = {15,16,17,15,62};

    public student_4(String nm, int Id){
        name= nm;
        id =Id;
    }

    public void addCourse(Course C){
        CourseDtls [coursecount] = C;
        coursecount++;
        
    }
     public void addCourse(Course C1, Course C2){
        addCourse(C1);
        addCourse(C2); 
    }
    public void addCourse(Course C1, Course C2, Course C3){
        addCourse(C1);
        addCourse(C2); 
        addCourse(C3);
    }



    public void showDetails(){
        System.out.println("Student name: "+ name);
        System.out.println("ID: "+id);
        System.out.println("----------------------------------");
        System.out.println("Course Taken: ");

        for(int c = 0 ; coursecount>c; c++){
        System.out.println(CourseDtls[c].courseCode +" "+ CourseDtls[c].courseTitle) ;
        }
        System.out.println(Arrays.toString(CourseDtls));
        System.out.println(Arrays.toString(arr1));
        System.out.println("===============================");

    }

    
}


